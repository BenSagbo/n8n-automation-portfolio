      "parameters": {
        "jsCode": "const d = $json.body.data;\nconst byKey = Object.fromEntries(d.fields.map(f => [f.key, f]));\nconst val = (k) => {\n  const f = byKey[k];\n  if (!f) return '';\n  if (f.options) {\n    return f.options\n      .filter(o => (f.value || []).includes(o.id))\n      .map(o => o.text).join(', ');\n  }\n  return String(f.value ?? '').trim();\n};\n\nreturn {\n  json: {\n    firstName: val('question_lVPN4p'),\n    lastName: val('question_R87zrp'),\n    email: val('question_ol4AxX').toLowerCase(),\n    businessType: val('question_YVLO70'),\n    budget: val('question_D0l1Rp'),\n    need: val('question_lVPA86'),\n    submissionId: d.submissionId,\n    submittedAt: d.createdAt\n  }\n};"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
