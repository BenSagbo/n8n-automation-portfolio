        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify({\n  model: \"claude-sonnet-5-5\",\n  max_tokens: 2000,\n  system: \"You qualify inbound leads for a service business that builds AI automations. Judge four things: FIT (is this an automation problem we solve?), CLARITY (is the need specific?), URGENCY (is there a pain or deadline?), and BUDGET (can they afford $500+?). HOT: strong fit, clear need, and budget that matches the scope. WARM: real fit, but the need is vague or the budget is tight. COLD: no automation fit, or clearly unable to pay. Set needs_review true for spam, tests, gibberish, or contradictions. Reason: one sentence under 20 words naming the deciding factor.\",\n  output_config: {\n    effort: \"low\",\n    format: {\n      type: \"json_schema\",\n      schema: {\n        type: \"object\",\n        properties: {\n          score: { type: \"string\", enum: [\"hot\", \"warm\", \"cold\"] },\n          reason: { type: \"string\" },\n          needs_review: { type: \"boolean\" }\n        },\n        required: [\"score\", \"reason\", \"needs_review\"],\n        additionalProperties: false\n      }\n    }\n  },\n  messages: [{\n    role: \"user\",\n    content: \"Business type: \" + $json.businessType + \"\\nBudget: \" + $json.budget + \"\\nWhat they need: \" + $json.need\n  }]\n}) }}\n\n",
        "options": {}
      },
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.5,
      "position": [
        448,
        192
      ],
      "id": "eafe071f-4fa3-4c63-aeb0-ff438939dd73",
      "name": "Score with Claude",
      "credentials": {
        "httpHeaderAuth": {
          "id": "YOUR_CREDENTIAL_ID",
          "name": "Anthropic"
        }
      }
    },
    {
      "parameters": {
        "jsCode": "const lead = $('Clean Lead').item.json;\nlet score = 'warm', reason = 'Could not parse AI score', needsReview = true;\n\ntry {\n  const textBlock = ($json.content || []).find(c => c.type === 'text');\n  const parsed = JSON.parse(textBlock.text);\n  if (['hot', 'warm', 'cold'].includes(parsed.score)) {\n    score = parsed.score;\n    reason = String(parsed.reason || '').slice(0, 250);\n    needsReview = parsed.needs_review === true;\n  }\n} catch (e) {\n  // keep the safe defaults: flagged for human review\n}\n\nreturn { json: { ...lead, score, reason, needsReview } };"
      },
      "type": "n8n-nodes-base.code",
